# Local Docker Compose configuration. Copy to .env and fill required blank values.
# Do not use local credentials for production or commit your .env file.
MYSQL_DATABASE=smartmeal
DB_URL=jdbc:mysql://db:3306/smartmeal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=smartmeal
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Generate a random secret of at least 32 bytes; keep it private.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Optional: set both values to create the initial administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOKING_CUTOFF_MINUTES=30
AI_SERVICE_URL=http://ai-service:5001
AI_SERVICE_CONNECT_TIMEOUT_MS=2000
AI_SERVICE_READ_TIMEOUT_MS=4000
